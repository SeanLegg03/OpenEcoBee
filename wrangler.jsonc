{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openecobee-mcp",
  "main": "cloud/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "THERMOSTAT_SESSIONS", "class_name": "ThermostatSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThermostatSession"] }
  ],
  "kv_namespaces": [
     { "binding": "OAUTH_KV", "id": "7f5688728cb84ff58cf5888614c18d5f" }
  ],
    "vars": {
    "GITHUB_CLIENT_ID": "Ov23liM82mFSRrtbICp3",
    "ALLOWED_GITHUB_USERS": "SeanLegg03",
    "PUBLIC_ORIGIN": "https://openecobee-mcp.seanlegg.workers.dev"
  },
  "observability": { "enabled": false }
}
